# Server
PORT=4000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://localhost:27017/gtc_admin

# JWT
JWT_SECRET=doi_chuoi_nay_thanh_chuoi_bi_mat_that_dai_va_ngau_nhien
JWT_EXPIRES_IN=7d

# Dùng cho script tạo tài khoản admin đầu tiên (npm run seed:admin)
ADMIN_NAME=Super Admin
ADMIN_EMAIL=admin@molii.vn
ADMIN_PASSWORD=doi_mat_khau_nay_truoc_khi_seed

# CORS - domain của frontend được phép gọi API (cách nhau bởi dấu phẩy nếu nhiều)
CLIENT_ORIGIN=http://localhost:5173

XF_APPID=
XF_API_KEY=
XF_API_SECRET=
XF_ISE_CHECK_TYPE=hard
# XF_DEBUG=1   # bật khi cần soi log chi tiết lúc debug

# Lưu lịch sử luyện nói (bản ghi âm + kết quả chấm) để admin đối chứng.
# BẬT (true) trong giai đoạn phát triển/nghiệm thu.
# TẮT (false hoặc bỏ trống) khi tung ra thị trường — khi đó bản ghi âm chỉ tồn
# tại tạm trong bộ nhớ trình duyệt học viên, tải lại trang là mất.
PRACTICE_HISTORY_ENABLED=false
